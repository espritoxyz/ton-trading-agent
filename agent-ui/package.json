{
  "name": "agent-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "dev:all": "concurrently -n BACKEND,FRONTEND -c blue,green \"cd ../agent-backend && ./gradlew bootRun\" \"vite\""
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "axios": "^1.13.5",
    "lucide-vue-next": "^0.563.0",
    "vue": "^3.4.38",
    "vue-router": "^4.3.4",
    "vue3-yandex-metrika": "^0.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "to-ico": "^1.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.1",
    "vue-tsc": "^2.1.10"
  }
}
